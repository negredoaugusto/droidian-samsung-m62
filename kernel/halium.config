# Fragmento Ubuntu Touch / Halium para exynos9820-f62 (aplicar sobre exynos9820-f62_defconfig)
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_USER_NS=y
CONFIG_AUTOFS4_FS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY="apparmor"
CONFIG_BINFMT_MISC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CMDLINE="androidboot.boot_devices=13d60000.ufs console=tty0"
