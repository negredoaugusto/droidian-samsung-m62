# Fragmento Droidian para exynos9820-f62 (aplicado DEPOIS de ubuntu-touch/halium.config)
# cmdline: o bootloader Samsung ignora o cmdline do boot.img, então vai embutido no kernel
# (mesma abordagem do port Droidian do Galaxy S9: "console=tty0 droidian.lvm.prefer")
CONFIG_CMDLINE="androidboot.boot_devices=13d60000.ufs console=tty0 droidian.lvm.prefer cgroup_disable=schedtune systemd.journald.forward_to_kmsg=yes log_buf_len=8M"
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# libera espaço: BOOT tem 61,9 MB e o initramfs Droidian é grande (símbolos de funções continuam)
# CONFIG_KALLSYMS_ALL is not set
